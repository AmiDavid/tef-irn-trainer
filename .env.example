# Server-only (Vercel → Settings → Environment Variables). Never put keys in the browser.

# Text AI (writing/speaking assessment, tutor, notebook scan).
# Default provider = Claude when ANTHROPIC_API_KEY is set.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional: override the model (current ids, e.g. claude-sonnet-5-5). Falls back to claude-haiku-5-5.
ANTHROPIC_MODEL=
ANTHROPIC_QA_MODEL=

# OpenAI — required only for the live voice examiner (Realtime) and audio transcription.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_QA_MODEL=gpt-5.6-luna
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_VOICE=marin

# Second language-QA pass on AI corrections (recommended).
OPENAI_QA_SECOND_PASS=true

# Supabase (sign-in + progress sync)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Origins allowed to call the API (CORS). Needed so the GitHub Pages app can use the Vercel backend.
APP_ORIGIN=https://amidavid.github.io
